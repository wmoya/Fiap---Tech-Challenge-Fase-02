# Copie para .env e preencha.  NUNCA faça commit do .env (está no .gitignore)
AWS_REGION=us-east-1
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/togglemaster-events
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

PG_USER=togglemaster
PG_PASSWORD=troque-esta-senha

# Chave mestra do auth-service (cria novas API keys)
MASTER_KEY=troque-esta-master-key

# Chave que o evaluation-service usa para chamar flag/targeting.
# Gere com:  echo "tm_key_$(openssl rand -hex 32)"
SERVICE_API_KEY=tm_key_troque
