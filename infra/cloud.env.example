# Copie para infra/cloud.env e preencha DURANTE o laboratório.
# Este arquivo contém senhas: está no .gitignore e não deve ser commitado nem aparecer no vídeo.
export AWS_REGION=us-east-1
export AWS_ACCOUNT_ID=            # aws sts get-caller-identity --query Account --output text
export IMAGE_TAG=v1
export CLUSTER_NAME=togglemaster

# SQS / DynamoDB
export AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/${AWS_ACCOUNT_ID}/togglemaster-events
export AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# RDS (mesmo usuário nos 3; senha forte: openssl rand -base64 24 | tr -d '/+=')
export DB_USER=togglemaster
export DB_PASSWORD=
export RDS_AUTH_ENDPOINT=         # togglemaster-auth-db.xxxx.us-east-1.rds.amazonaws.com
export RDS_FLAG_ENDPOINT=
export RDS_TARGETING_ENDPOINT=

# ElastiCache (com criptografia em trânsito = rediss://  | sem = redis://)
export REDIS_URL=rediss://master.togglemaster-redis.xxxx.use1.cache.amazonaws.com:6379

# Chaves da aplicação (gere com: echo "tm_key_$(openssl rand -hex 32)")
export MASTER_KEY=
export SERVICE_API_KEY=
