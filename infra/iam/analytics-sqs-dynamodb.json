{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumirFila",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:GetQueueUrl", "sqs:ChangeMessageVisibility"],
      "Resource": "arn:aws:sqs:us-east-1:<ACCOUNT_ID>:togglemaster-events"
    },
    {
      "Sid": "GravarAnalytics",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:DescribeTable"],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/ToggleMasterAnalytics"
    }
  ]
}
